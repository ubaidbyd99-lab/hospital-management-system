# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

FLASK_SECRET_KEY=replace-with-a-long-random-string
FLASK_DEBUG=true

# Dedicated application user (do NOT use SYSTEM for daily app access)
ORACLE_USER=hms_app
ORACLE_PASSWORD=replace-with-hms-app-password
ORACLE_HOST=localhost
ORACLE_PORT=1521

# Oracle XE 11g usually uses SID = XE
ORACLE_SID=XE

# Leave empty unless your campus setup uses a service name instead of SID
ORACLE_SERVICE=

# Oracle XE 11g requires thick mode. Point this to Instant Client.
# Example: C:\oracle\instantclient_21_13
ORACLE_CLIENT_LIB=C:\oracle\instantclient_21_13

# Created automatically on first successful start if the USERS table is empty
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@123
DEFAULT_ADMIN_FULL_NAME=Hospital Administrator
